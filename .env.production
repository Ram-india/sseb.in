# Read by `npm run build`. A GA4 measurement ID is public (it ships in the page
# source either way), so it is fine to keep here in the repo.
#
# Get it from analytics.google.com → Admin → Data streams → your web stream:
# the "MEASUREMENT ID" in the top right, of the form G-XXXXXXXXXX.
#
# Leave it empty to ship the site with no analytics at all — no gtag.js request
# is made and no cookies are set.
VITE_GA_MEASUREMENT_ID=

# Set to true in a local `.env.local` to also send hits from `npm run dev`,
# which is how you verify the tag in GA's Realtime report before deploying.
# VITE_GA_DEBUG=true
